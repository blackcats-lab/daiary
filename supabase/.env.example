# Supabase CLI（config.toml の env() 参照）用シークレット
# 本ファイルをコピーして supabase/.env.local を作り、実値を入れる。
# .env.local は .gitignore 対象。
#
# Edge Functions 用のシークレット（GEMINI_API_KEY 等）はここではなく
# supabase/functions/.env.local に置く（supabase/functions/.env.example 参照）。

# ===== Supabase OAuth (任意) =====
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=
