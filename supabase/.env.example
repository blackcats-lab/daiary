# Edge Functions / ローカル開発用シークレット
# 本ファイルをコピーして supabase/.env.local を作り、実値を入れる。
# .env.local は .gitignore 対象。

# ===== AI =====
# Google AI Studio で取得した Gemini API キー
GEMINI_API_KEY=

# AI モデル設定（_shared/ai-service.ts のデフォルト値を上書きしたい場合）
# 例: gemini-2.5-flash-lite, gemini-2.5-pro
AI_MODEL=gemini-2.5-flash-lite
AI_PROVIDER=gemini

# ===== RevenueCat Webhook =====
# RevenueCat 側で設定する Webhook 認証ヘッダー
REVENUECAT_WEBHOOK_AUTH=

# ===== Supabase OAuth (任意) =====
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=
