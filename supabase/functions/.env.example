# `supabase functions serve --env-file supabase/.env.local` で読み込まれる。
# 本ファイルをコピーして supabase/.env.local を作成し、実値を入れる。

GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash-lite

REVENUECAT_WEBHOOK_AUTH=

# Supabase 自体の URL / キーはローカル環境では `supabase status` の出力を使用。
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
